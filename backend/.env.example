# RoadSafe AI backend — optional provider keys.
# The app starts and works without any of these; each provider has a
# deterministic demo fallback and responses are always labelled LIVE/DEMO.

# TomTom Routing + Traffic (one key covers both)
ROUTING_API_KEY=
TRAFFIC_API_KEY=

# OpenWeatherMap current conditions (weather-aware safety scores)
WEATHER_API_KEY=

# Google Gemini (AI-powered Sleep Drive conversation)
AI_API_KEY=

# Optional map key (not used — we use open OSM/CARTO tiles)
MAP_API_KEY=

# Routing endpoint overrides
# OSRM_URL=https://router.project-osrm.org
# SEGMENT_TARGET_METERS=750
# MAX_SEGMENTS=10
