[TEMPLATE]
# RoadSafe AI / Routiq backend — optional provider keys.
# The app starts and works without any of these; each provider has a
# deterministic demo fallback and responses are always labelled LIVE/DEMO.
# NEVER commit real keys. Copy this file to `.env` and fill in your own.

# TomTom Routing + Traffic (one key covers both)
ROUTING_API_KEY=
TRAFFIC_API_KEY=

# OpenWeatherMap current conditions (weather-aware safety scores)
WEATHER_API_KEY=

# Google Gemini (legacy Sleep Drive conversation fallback)
AI_API_KEY=

# Groq — conversational reasoning + intent classification for Sleep Drive
# (backend-only, never exposed to the frontend)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Sarvam — Saaras v3 speech-to-text (backend-only)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh

# LiveKit realtime session (browser -> room -> voice agent)
# Local dev default: ws://localhost:7880 / devkey / devsecret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_ROOM_NAME=routiq-sleep-drive
LIVEKIT_IDENTITY_PREFIX=driver

# ElevenLabs — optional alternative TTS / conversational AI (backend-only).
# Leave ELEVENLABS_AGENT_ID empty unless you intend to run the agent transport;
# the Groq + Sarvam stack is the primary Sleep Drive voice pipeline.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER=sarvam
STT_PROVIDER=sarvam

# AI provider tuning (seconds) — transient failures are retried with backoff
# GROQ_TIMEOUT=6
# SARVAM_TIMEOUT=15

# Sleep Drive default conversation language (BCP-47, or "auto" to detect)
SLEEP_DRIVE_LANGUAGE=en-IN

# Optional map key (not used — we use open OSM/CARTO tiles)
MAP_API_KEY=

# Routing endpoint overrides
# OSRM_URL=https://router.project-osrm.org
# SEGMENT_TARGET_METERS=750
# MAX_SEGMENTS=10

# Emergency / hospital discovery (OpenStreetMap Overpass)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
# HOSPITAL_SEARCH_RADIUS_KM=15
# HOSPITAL_ETA_CANDIDATES=12   # nearest OSM hospitals we compute real OSRM ETAs for
# EMERGENCY_COUNTDOWN_SECONDS=60
